{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "Discord bot that plays music from YouTube",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "ensure-bins": "node scripts/ensure-bins.mjs",
    "start": "node scripts/ensure-bins.mjs && node src/index.js",
    "deploy-commands": "node src/deploy-commands.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.1",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "youtube-dl-exec": "^3.1.13"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "youtube-dl-exec@3.1.13": true
  }
}
