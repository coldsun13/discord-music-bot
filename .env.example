DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
# Optional: leave empty to register commands globally (can take up to 1 hour)
GUILD_ID=

# Optional: override the built-in public Lavalink nodes (JSON array).
# These nodes fetch YouTube themselves, so the host IP being blocked doesn't matter.
# LAVALINK_NODES=[{"name":"my-node","url":"host:443","auth":"password","secure":true}]
# Set to true to always use local yt-dlp + ffmpeg instead of a node.
# LAVALINK_DISABLED=false

# Only used by the local fallback (yt-dlp on this server's IP).
# Optional: base64 of cookies.txt (for hosts where file upload is broken)
# YTDLP_COOKIES_BASE64=

# Preferred (safer than base64 in hosting UIs):
# YTDLP_COOKIES_HEX=
